:root {
    --bg-color: rgb(3, 7, 18);
    --surface-color: rgb(31, 41, 55);
    --surface-dark: rgb(17, 24, 39);
    --primary-color: rgb(0, 122, 255);
    --accent-color: rgb(16, 185, 129);
    --text-color: rgb(249, 250, 251);
    --text-muted: rgb(156, 163, 175);
    --warning-color: rgb(251, 191, 36);
    --hover-overlay: rgba(255, 255, 255, 0.05);
    --danger-color: rgb(239, 68, 68);
    --info-color: rgb(96, 165, 250);
    --chat-user-bg: rgb(0, 122, 255);
    --chat-asistan-bg: rgb(30, 41, 59);
    --saat-color: rgb(0, 255, 255);
}

.theme-acik {
    --bg-color: rgb(243, 244, 246);
    --surface-color: rgb(255, 255, 255);
    --surface-dark: rgb(229, 231, 235);
    --primary-color: rgb(37, 99, 235);
    --accent-color: rgb(5, 150, 105);
    --text-color: rgb(17, 24, 39);
    --text-muted: rgb(107, 114, 128);
    --warning-color: rgb(217, 119, 6);
    --hover-overlay: rgba(0, 0, 0, 0.05);
    --danger-color: rgb(220, 38, 38);
    --info-color: rgb(37, 99, 235);
    --chat-user-bg: rgb(37, 99, 235);
    --chat-asistan-bg: rgb(229, 231, 235);
    --saat-color: rgb(5, 150, 105);
}

.theme-neon {
    --bg-color: rgb(10, 0, 20);
    --surface-color: rgb(20, 5, 40);
    --surface-dark: rgb(15, 0, 30);
    --primary-color: rgb(176, 38, 255);
    --accent-color: rgb(0, 255, 255);
    --text-color: rgb(255, 255, 255);
    --text-muted: rgb(180, 150, 200);
    --warning-color: rgb(255, 255, 0);
    --hover-overlay: rgba(255, 0, 255, 0.15);
    --danger-color: rgb(255, 50, 50);
    --info-color: rgb(200, 100, 255);
    --chat-user-bg: rgb(255, 0, 255);
    --chat-asistan-bg: rgb(20, 5, 40);
    --saat-color: rgb(0, 255, 255);
}

VisualElement {
}

Label, TextElement {
    white-space: normal;
    overflow: visible;
}

/* Panel Backgrounds (Dynamic based on theme) */
.panel-surface {
    background-color: var(--surface-color);
}

.panel-surface-dark {
    background-color: var(--surface-dark);
}

.modal-overlay {
    background-color: rgba(0, 0, 0, 0.85);
}

.modern-kart {
    background-color: var(--bg-color);
    border-radius: 20px;
    padding: 20px;
    margin: 10px;
}

/* CSS Animations for Task Cards */
.kart-animasyonlu {
    transition-property: translate, opacity, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    translate: 0 0;
    opacity: 1;
}

.kart-silindi {
    translate: 100% 0;
    opacity: 0;
}

.kart-tamamlandi {
    translate: 20px 0;
    background-color: var(--accent-color) !important;
}

.header-title {
    color: var(--text-color);
    font-size: 17px;
    -unity-font-style: bold;
}

.header-status {
    color: var(--accent-color);
    font-size: 12px;
    margin-top: 2px;
}

.chat-ekrani {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 20px;
    background-color: var(--bg-color);
}

.bottom-bar {
    background-color: var(--bg-color);
    padding-top: 10px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
}

.premium-input {
    width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    height: 50px;
    margin-right: 15px;
    background-color: transparent;
    border-width: 0;
}

.premium-input > .unity-text-field__input {
    background-color: var(--surface-color);
    color: var(--text-color);
    --unity-cursor-color: var(--primary-color);
    border-width: 0;
    border-radius: 25px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 16px;
    -unity-text-align: middle-left;
}

.premium-input > .unity-text-field__input:focus {
    border-width: 1px;
    border-color: var(--primary-color);
}

.premium-buton {
    width: 100px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 25px;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255); /* Buton içi beyaz kalsın */
    font-size: 16px;
    -unity-font-style: bold;
    border-width: 0;
    transition-duration: 0.2s;
}

.premium-buton:hover {
    scale: 1.05;
}

.chat-ekrani .unity-scroller--vertical {
    width: 6px;
    background-color: transparent;
    border-width: 0;
    margin-right: 2px;
}

.chat-ekrani .unity-scroller__low-button,
.chat-ekrani .unity-scroller__high-button {
    display: none;
}

.chat-ekrani .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.chat-ekrani .unity-base-slider__dragger {
    background-color: rgba(150, 150, 150, 0.5);
    border-radius: 3px;
    border-width: 0;
    width: 6px;
    left: 0;
}

.main-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
    background-color: var(--bg-color); /* Tema ana arkaplanı burası alsın */
}

.page {
    flex-grow: 1;
    flex-shrink: 1;
    display: none;
}

.tab-button {
    background-color: transparent;
    border-width: 0;
    color: var(--text-muted);
    font-size: 16px;
    -unity-font-style: bold;
    flex-grow: 1;
    height: 100%;
    border-radius: 0;
    background-image: none;
    -unity-background-scale-mode: scale-to-fit;
}

.tab-button:hover {
    background-color: var(--hover-overlay);
    color: var(--text-color);
}

.tab-button-active {
    color: var(--primary-color);
    border-top-width: 3px;
    border-top-color: var(--primary-color);
    background-color: var(--hover-overlay);
}

.modern-progress {
    height: 8px;
    margin-left: 20px;
    margin-right: 20px;
}

.modern-progress .unity-progress-bar__background {
    background-color: var(--hover-overlay);
    border-radius: 4px;
    border-width: 0;
}

.modern-progress .unity-progress-bar__progress {
    background-color: var(--accent-color);
    border-radius: 4px;
    margin: 0;
}

/* ━━━ FAZ 2: ANİMASYON STİLLERİ ━━━ */

.task-card {
    background-color: var(--surface-color);
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 15px;
    border-left-width: 4px;
    border-left-color: var(--accent-color);
    color: var(--text-color);
    width: 100%;
    flex-shrink: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.mesaj-balonu {
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in;
    color: var(--text-color);
}

.typing-indicator {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    background-color: var(--surface-color);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 15px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 18px;
    padding-right: 18px;
    margin-bottom: 10px;
}

.typing-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--text-muted);
    margin-right: 5px;
}

.undo-toast {
    position: absolute;
    bottom: 80px;
    left: 10%;
    right: 10%;
    background-color: var(--surface-color);
    border-radius: 12px;
    padding: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-left-width: 4px;
    border-left-color: var(--warning-color);
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.undo-toast Label {
    color: var(--text-color);
}

.top-bar {
    height: auto;
    padding: 10px 0;
    padding-top: 40px;
    background-color: var(--surface-dark);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--surface-color);
    flex-shrink: 0;
}

.tab-bar {
    height: 60px;
    padding-bottom: 15px;
    flex-direction: row;
    background-color: var(--surface-dark);
    border-top-width: 1px;
    border-top-color: var(--surface-color);
    justify-content: space-around;
    align-items: center;
    flex-shrink: 0;
}

/* ━━━ MESAJ BALONU TEMA UYUMU ━━━ */

.mesaj-kullanici {
    background-color: var(--chat-user-bg);
}

.mesaj-asistan {
    background-color: var(--chat-asistan-bg);
}

/* ━━━ GÖREV KARTI TEMA UYUMU ━━━ */

.task-text {
    color: var(--text-color);
}

.task-saat {
    color: var(--saat-color);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

/* ━━━ OVERLAY TEMA UYUMU ━━━ */

.overlay-panel {
    background-color: var(--surface-dark);
    border-radius: 12px;
    padding: 20px;
}

.overlay-title {
    color: var(--info-color);
    -unity-font-style: bold;
}

.overlay-label {
    color: var(--text-muted);
}

.overlay-input > .unity-text-field__input {
    background-color: var(--surface-color);
    color: var(--text-color);
    border-radius: 6px;
}

/* ━━━ TAB BAR ANİMASYONU ━━━ */
.tab-button {
    transition-property: unity-background-image-tint-color, scale, border-bottom-width, border-bottom-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    border-bottom-width: 0;
}

.tab-button-active {
    border-bottom-width: 3px;
    border-bottom-color: var(--primary-color);
    scale: 1.1;
}

/* ━━━ GÖREV ÖNCELİK RENKLERİ ━━━ */
.oncelik-dusuk {
    border-left-width: 4px;
    border-left-color: var(--accent-color);
}
.oncelik-orta {
    border-left-width: 4px;
    border-left-color: var(--info-color);
}
.oncelik-yuksek {
    border-left-width: 4px;
    border-left-color: var(--danger-color);
}

/* ==========================================
   CSS / USS FIXES (Arama Çubuğu, Scrollbar, Toggle, Tema Butonları)
   ========================================== */

/* 1. Arama Çubuğu (Search Bar) Standardizasyonu */
#inputSohbetArama {
    min-height: 40px;
    padding: 0;
    margin-top: 5px;
    margin-bottom: 5px;
}

#inputSohbetArama > .unity-base-text-field__input {
    background-color: var(--surface-color);
    border-radius: 20px;
    border-width: 0;
    color: var(--text-muted);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 15px;
    padding-right: 15px;
    height: 100%;
}

/* 2. Siber Scrollbar (Kaydırma Çubuğu) */
.unity-scroller {
    background-color: transparent;
    width: 6px;
}
.unity-scroller__slider {
    background-color: transparent;
    width: 6px;
    margin: 0;
}
.unity-scroller__dragger {
    background-color: var(--surface-color);
    border-radius: 3px;
    width: 6px;
    left: 0;
}
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroll-view__vertical-scroller { 
    width: 6px; 
    margin-right: 2px; 
}
.unity-base-slider__tracker { 
    background-color: transparent; 
    border-width: 0; 
}
.unity-base-slider__dragger { 
    background-color: rgba(255, 255, 255, 0.15); 
    border-radius: 3px; 
    border-width: 0; 
}
.unity-base-slider__dragger:hover { 
    background-color: rgba(255, 255, 255, 0.3); 
}

/* 3. Checkbox / Toggle Uyumu */
.unity-toggle__checkmark {
    background-color: var(--surface-dark);
    border-color: var(--text-muted);
    border-width: 1px;
    border-radius: 4px;
    -unity-background-image-tint-color: var(--text-color);
}
.unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--accent-color);
    border-width: 0;
    -unity-background-image-tint-color: var(--bg-color);
}

/* 4. Tema Butonları Bütünlüğü */
.theme-btn {
    background-color: var(--surface-dark);
    color: var(--text-muted);
    border-radius: 6px;
    padding: 8px 12px;
    margin-right: 5px;
    border-width: 1px;
    border-color: var(--surface-color);
    -unity-font-style: normal;
    transition-duration: 0.2s;
}

/* Aktif (Seçili) Tema Butonları */
.theme-koyu #btnTemaKoyu,
.theme-acik #btnTemaAcik,
.theme-neon #btnTemaNeon {
    background-color: var(--primary-color);
    color: #ffffff;
    border-color: var(--accent-color);
    -unity-font-style: bold;
}
