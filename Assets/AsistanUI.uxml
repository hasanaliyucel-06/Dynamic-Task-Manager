<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/ModernTheme.uss?fileID=7433441132597879392&amp;guid=15056cd9b967be844ad7112af93a890b&amp;type=3#ModernTheme"/>
    <ui:VisualElement class="main-container" style="flex-grow: 1;">
        <ui:VisualElement name="Page_Sohbet" class="page" style="display: flex;">
            <ui:VisualElement name="UstBar" class="top-bar">
                <ui:Label text="SİBER ASİSTAN" class="header-title"/>
                <ui:Label text="Çevrimiçi" class="header-status"/>
            </ui:VisualElement>
            <ui:ScrollView name="scrollSohbet" class="chat-ekrani"/>
            <ui:VisualElement name="AltKutu" class="bottom-bar" style="flex-direction: row; align-items: center;">
                <ui:TextField placeholder-text="Asistana emret..." name="txtMesaj" class="premium-input" style="flex-grow: 1; margin-right: 8px;"/>
                <ui:Button text="↑" name="btnGonder" enable-rich-text="true" class="premium-buton" style="width: 45px; height: 45px; border-radius: 25px; font-size: 24px; -unity-text-align: middle-center; padding: 0; margin: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Page_Gorevler" class="page" style="display: none;">
            <ui:VisualElement class="top-bar">
                <ui:Label text="GÖREV YÖNETİMİ" class="header-title"/>
                <ui:Label text="0 Aktif Görev" class="header-status" style="color: rgb(96, 165, 250);"/>
            </ui:VisualElement>
            <ui:VisualElement style="background-color: rgba(0, 0, 0, 0); border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-color: #333333; height: 15px; border-radius: 5px; margin: 10px 15px;">
                <ui:VisualElement name="progressBarFill" style="width: 0%; height: 100%; background-color: #00FF00; border-radius: 5px;" />
            </ui:VisualElement>
            <ui:ScrollView name="gorevlerScrollView" class="chat-ekrani" style="flex-grow: 1;" />
            <ui:VisualElement class="bottom-bar" style="flex-direction: row; align-items: center;">
                <ui:TextField placeholder-text="Yeni görev ekle..." name="Input_YeniGorev" class="premium-input" style="flex-grow: 3; flex-shrink: 1; margin-right: 8px;"/>

                <ui:Button text="↑" name="Btn_GorevEkle" enable-rich-text="true" class="premium-buton" style="width: 45px; height: 45px; border-radius: 25px; font-size: 24px; -unity-text-align: middle-center; padding: 0; margin: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pageDisiplin" class="page" style="display: none;">
            <ui:VisualElement class="top-bar" style="flex-direction: column; align-items: stretch; padding-top: 40px; padding-bottom: 10px;">
                <ui:Label text="AKILLI HEDEFLER VE TAKVİM" style="color: white; -unity-font-style: bold; font-size: 20px; -unity-text-align: middle-center; margin-bottom: 10px;"/>
            </ui:VisualElement>

            <!-- Akıllı Hedef Paneli -->
            <ui:VisualElement style="background-color: #2a3441; border-radius: 12px; padding: 10px; margin-top: 5px; margin-right: 15px; margin-bottom: 5px; margin-left: 15px; flex-direction: column;">
                <ui:TextField name="inputHedef" placeholder-text="Hedefin nedir? (Örn: Suç ve Ceza'yı bitir)" class="premium-input" style="width: 100%; margin-bottom: 0;" />
                
                <ui:VisualElement name="sabitTakvimContainer" style="background-color: #1c2331; border-radius: 12px; padding: 10px; margin-top: 15px; margin-bottom: 10px; flex-direction: column;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <ui:Button name="btnTakvimOnceki" text="&lt;" style="background-color: transparent; color: white; border-width: 0; font-size: 16px; -unity-font-style: bold; padding: 5px;" />
                        <ui:Label name="lblTakvimAyYil" text="Ay Yıl" style="color: white; -unity-font-style: bold; font-size: 16px; -unity-text-align: middle-center;" />
                        <ui:Button name="btnTakvimSonraki" text="&gt;" style="background-color: transparent; color: white; border-width: 0; font-size: 16px; -unity-font-style: bold; padding: 5px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 5px;">
                        <ui:Label text="Pzt" style="color: #9CA3AF; font-size: 12px; width: 35px; -unity-text-align: middle-center; padding: 0;" />
                        <ui:Label text="Sal" style="color: #9CA3AF; font-size: 12px; width: 35px; -unity-text-align: middle-center; padding: 0;" />
                        <ui:Label text="Çar" style="color: #9CA3AF; font-size: 12px; width: 35px; -unity-text-align: middle-center; padding: 0;" />
                        <ui:Label text="Per" style="color: #9CA3AF; font-size: 12px; width: 35px; -unity-text-align: middle-center; padding: 0;" />
                        <ui:Label text="Cum" style="color: #9CA3AF; font-size: 12px; width: 35px; -unity-text-align: middle-center; padding: 0;" />
                        <ui:Label text="Cmt" style="color: #9CA3AF; font-size: 12px; width: 35px; -unity-text-align: middle-center; padding: 0;" />
                        <ui:Label text="Paz" style="color: #9CA3AF; font-size: 12px; width: 35px; -unity-text-align: middle-center; padding: 0;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="takvimGunleriWrap" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start;" />
                </ui:VisualElement>

                <ui:Button name="btnAiPlanla" text="YAPAY ZEKAYA PLANLAT" class="premium-buton" style="width: 100%; padding: 10px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: #005BB5; border-radius: 8px;" />
            </ui:VisualElement>


        </ui:VisualElement>
        <ui:VisualElement name="pageSistem" class="page" style="display: none;">
            <ui:VisualElement class="top-bar">
                <ui:Label text="SİSTEM" class="header-title"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="TabBar" class="tab-bar" style="background-color: transparent; border-width: 0; justify-content: space-around; flex-direction: row;">
        <ui:Button text="" name="Btn_TabSohbet" class="tab-button tab-button-active" style="background-color: transparent; border-width: 0; width: 35px; height: 35px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Icons/ai.png?fileID=2800000&amp;guid=27f7a582bb31c88418810874ac0d1ea8&amp;type=3#ai&quot;);"/>
        <ui:Button text="" name="Btn_TabGorevler" class="tab-button" style="background-color: transparent; border-width: 0; width: 35px; height: 35px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Icons/tasks.png?fileID=2800000&amp;guid=ac353ab2e97baf949970c680608234aa&amp;type=3#tasks&quot;);"/>
        <ui:Button text="" name="btnDisiplin" class="tab-button" style="background-color: transparent; border-width: 0; width: 35px; height: 35px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Icons/calendar.png?fileID=2800000&amp;guid=dea395e21aa5de94c8baa0eeebe23bf9&amp;type=3#calendar&quot;);"/>
        <ui:Button text="" name="btnSistem" class="tab-button" style="background-color: transparent; border-width: 0; width: 35px; height: 35px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Icons/dashboard.png?fileID=2800000&amp;guid=afc942f2d93568f40b9361beb737a07c&amp;type=3#dashboard&quot;);"/>
    </ui:VisualElement>
    
    <ui:VisualElement name="gorevSihirbaziOverlay" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); display: none; align-items: center; justify-content: center;">
        <ui:VisualElement name="popupKutu" style="background-color: #1c2331; border-radius: 12px; padding: 20px; width: 80%;">
            <ui:Label name="lblSihirbazBaslik" text="Görev Süresi (Dk):" style="color: #00FFFF; -unity-font-style: bold; margin-bottom: 10px; font-size: 14px;" />
            <ui:TextField name="inputSihirbazDeger" style="margin-top: 15px; margin-bottom: 20px; background-color: #2a354b; color: white; border-radius: 6px; padding: 10px; font-size: 16px;" />
            <ui:VisualElement name="timeInputContainer" style="display: none; flex-direction: row; justify-content: center; align-items: center; margin-top: 15px; margin-bottom: 20px;">
                <ui:TextField name="inputSaat" max-length="2" style="width: 50px; font-size: 16px; -unity-text-align: middle-center;" />
                <ui:Label text=":" style="font-size: 20px; color: #00FFFF; -unity-font-style: bold; margin-left: 10px; margin-right: 10px;" />
                <ui:TextField name="inputDakika" max-length="2" style="width: 50px; font-size: 16px; -unity-text-align: middle-center;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Button name="btnSihirbazIptal" text="İPTAL" style="background-color: transparent; color: red; border-width: 0; flex-grow: 1; -unity-font-style: bold;" />
                <ui:Button name="btnSihirbazOnay" text="İLERİ" style="background-color: #005BB5; color: white; border-radius: 8px; flex-grow: 1; -unity-font-style: bold; padding: 10px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
